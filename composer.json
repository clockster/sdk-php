{
    "name": "clockster/sdk",
    "description": "Official PHP SDK for the Clockster Company API",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/clockster/sdk-php",
    "keywords": [
        "clockster",
        "sdk",
        "api-client",
        "openapi",
        "hr",
        "workforce-management",
        "attendance",
        "payroll"
    ],
    "authors": [
        {
            "name": "Clockster Pte. Ltd."
        }
    ],
    "support": {
        "issues": "https://github.com/clockster/sdk-php/issues",
        "docs": "https://api.clockster.com/openapi/v3.json"
    },
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0"
    },
    "suggest": {
        "psr/http-client": "To send calls through your own PSR-18 client instead of curl",
        "psr/http-factory": "Needed alongside psr/http-client for Psr18Transport"
    },
    "autoload": {
        "psr-4": {
            "Clockster\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Clockster\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "spec": "@php scripts/sync_spec.php",
        "generate": [
            "@php scripts/generate.php",
            "@php vendor/bin/pint --quiet src/Generated"
        ],
        "operations": "@php scripts/check_operations.php",
        "lint": "@php vendor/bin/pint --test",
        "analyse": "@php vendor/bin/phpstan analyse",
        "test": "@php vendor/bin/phpunit",
        "check": [
            "@lint",
            "@analyse",
            "@test",
            "@operations"
        ]
    }
}
